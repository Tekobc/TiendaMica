# ==============================================================================
# VARIABLES DE ENTORNO — ADONAI BY TIENDA MICA (SORTEOS)
# Copiá este archivo a .env.local y completá los valores correspondientes.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE (Base de datos Postgres + Auth + RLS)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
SUPABASE_SECRET_KEY=sb_secret_your-key # CRÍTICO: Solo servidor, nunca exponer al cliente
# También se aceptan NEXT_PUBLIC_SUPABASE_ANON_KEY y SUPABASE_SERVICE_ROLE_KEY (claves heredadas).

# ------------------------------------------------------------------------------
# 2. MERCADO PAGO (Checkout Pro + Webhook)
# Para Fase 2 (Pruebas/Sandbox): Usar credenciales que inicien con TEST-
# Para Fase 3 (Producción Real): Usar credenciales que inicien con APP_USR-
# ------------------------------------------------------------------------------
# Token de acceso (servidor)
MP_ACCESS_TOKEN=APP_USR-your-production-access-token # o TEST-... para sandbox
# Clave pública (opcional para el cliente si se requiere)
MP_PUBLIC_KEY=APP_USR-your-production-public-key     # o TEST-... para sandbox

# ------------------------------------------------------------------------------
# 3. CONFIGURACIÓN DEL SITIO Y DOMINIO
# En producción final (Vercel): https://tiendamica.com.ar
# En desarrollo local: http://localhost:3000
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://tiendamica.com.ar

# Opcionales para la pantalla post-compra (RF-14).
# Dejar vacío el link hasta recibir la URL oficial del canal/grupo del cliente.
NEXT_PUBLIC_WHATSAPP_CHANNEL_URL=
# Si no se define, la pantalla muestra el aviso de resultados con privacidad.
NEXT_PUBLIC_PUBLIC_RESULTS_TEXT=

# ------------------------------------------------------------------------------
# 4. GOOGLE OAUTH
# Configurar el proveedor Google desde Supabase > Authentication > Providers.
# ------------------------------------------------------------------------------
