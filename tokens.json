{
  "$schema": "https://designtokens.org/schemas/2025.10/format.json",
  "color": {
    "primitive": {
      "rose": {
        "50": { "$type": "color", "$value": "#fdf6f7" },
        "100": { "$type": "color", "$value": "#fbebee" },
        "200": { "$type": "color", "$value": "#f8d8de" },
        "300": { "$type": "color", "$value": "#f2b7c3" },
        "400": { "$type": "color", "$value": "#ea8ba0" },
        "500": { "$type": "color", "$value": "#de637f" },
        "600": { "$type": "color", "$value": "#ca4564" },
        "700": { "$type": "color", "$value": "#aa344e" }
      },
      "sage": {
        "50": { "$type": "color", "$value": "#f4f7f4" },
        "100": { "$type": "color", "$value": "#e5ede6" },
        "200": { "$type": "color", "$value": "#cfddcf" },
        "500": { "$type": "color", "$value": "#638766" },
        "600": { "$type": "color", "$value": "#4e6c51" },
        "700": { "$type": "color", "$value": "#3f5642" }
      },
      "neutral": {
        "cream": { "$type": "color", "$value": "#faf8f5" },
        "dark": { "$type": "color", "$value": "#171416" },
        "surface": { "$type": "color", "$value": "#ffffff" },
        "surfaceDark": { "$type": "color", "$value": "#211c1f" }
      }
    },
    "semantic": {
      "brand": {
        "primary": { "$type": "color", "$value": "{color.primitive.rose.500}" },
        "hover": { "$type": "color", "$value": "{color.primitive.rose.600}" },
        "subtle": { "$type": "color", "$value": "{color.primitive.rose.50}" }
      },
      "accent": {
        "sage": { "$type": "color", "$value": "{color.primitive.sage.500}" },
        "sageSoft": { "$type": "color", "$value": "{color.primitive.sage.50}" }
      },
      "surface": {
        "canvas": { "$type": "color", "$value": "{color.primitive.neutral.cream}" },
        "card": { "$type": "color", "$value": "{color.primitive.neutral.surface}" }
      }
    }
  },
  "dimension": {
    "spacing": {
      "xs": { "$type": "dimension", "$value": "4px" },
      "sm": { "$type": "dimension", "$value": "8px" },
      "md": { "$type": "dimension", "$value": "16px" },
      "lg": { "$type": "dimension", "$value": "24px" },
      "xl": { "$type": "dimension", "$value": "32px" }
    },
    "radius": {
      "md": { "$type": "dimension", "$value": "12px" },
      "lg": { "$type": "dimension", "$value": "16px" },
      "xl": { "$type": "dimension", "$value": "24px" },
      "full": { "$type": "dimension", "$value": "9999px" }
    }
  },
  "transition": {
    "micro": {
      "$type": "transition",
      "$value": {
        "duration": "150ms",
        "delay": "0ms",
        "timingFunction": [0.16, 1, 0.3, 1]
      }
    },
    "card": {
      "$type": "transition",
      "$value": {
        "duration": "250ms",
        "delay": "0ms",
        "timingFunction": [0.16, 1, 0.3, 1]
      }
    }
  }
}
